&lt;html&gt;
&lt;head&gt;
&lt;meta charset="utf-8"/&gt;
&lt;title&gt;Go Wasm 小游戏&lt;/title&gt;
&lt;/head&gt;
&lt;body&gt;
&lt;canvas id="game" width="400" height="300" style="border:1px solid #ccc"&gt;&lt;/canvas&gt;
&lt;script src="https://superbear.github.io/assets/wasm_exec.js"&gt;&lt;/script&gt;
&lt;script&gt;
const go = new Go();
WebAssembly.instantiateStreaming(fetch("/assets/game.260405.wasm"), go.importObject).then((result) =&gt; {
go.run(result.instance);
// 首次渲染
if (typeof wasmRender === "function") wasmRender();
});
&lt;/script&gt;
